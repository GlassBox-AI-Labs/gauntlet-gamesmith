{
  "name": "@gauntlet/db",
  "private": true,
  "version": "0.0.0",
  "exports": {
    "./types": "./types/supabase.ts"
  },
  "scripts": {
    "db:migrate": "supabase migration new",
    "db:up": "supabase migration up --local",
    "db:schema": "supabase db dump --local -f supabase/schema.sql",
    "db:types": "supabase gen types typescript --local > types/supabase.ts"
  }
}
